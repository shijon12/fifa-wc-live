# Create .env.local and provide a server-side OpenAI API key.
OPENAI_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional model override.
OPENAI_MODEL=gpt-5.4-mini

# Optional fantasy agent override. Defaults to the current agentic model.
FANTASY_AGENT_MODEL=gpt-5.6-sol

# Optional prediction model override. Defaults to OPENAI_MODEL, then gpt-5.6-sol.
PREDICTION_MODEL=gpt-5.6-sol

# Optional authenticated per-user request allowance (UTC day, 1-100).
FANTASY_AGENT_DAILY_LIMIT=20

# Optional shared protection for the team-comparison AI endpoint.
AI_ACCESS_CODE=

# Required in production. Use a long random value for signed auth sessions.
AUTH_SECRET=

# Background Web Push notifications.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://the-matchroom.vercel.app

# Optional paid/news provider override. Falls back to RSS when empty.
NEWS_API_URL=
NEWS_API_KEY=

# Optional weekly newsletter sending. Subscriptions work without these;
# sending is disabled until both are configured.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=The Matchroom <newsletter@yourdomain.com>
