# Create .env.local and provide a server-side OpenAI API key.
OPENAI_API_KEY=

# Optional model override.
OPENAI_MODEL=gpt-5.4-mini

# Required in production. Share this separate code with trusted friends.
AI_ACCESS_CODE=

# Background Web Push notifications.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
